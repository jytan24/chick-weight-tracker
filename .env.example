# Node
TZ=Asia/Kuala_Lumpur
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=jy_chick
# Set to true for Neon (and any hosted database)
DB_SSL=false

# Proxies in front of the app. 0 on your PC, 1 on Render.
TRUST_PROXY_HOPS=0

# Limiter
LIMITER_STORE=memory

# Frontend
VITE_APP_NAME="JY Chick"
